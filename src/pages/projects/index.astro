---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Security architecture, cloud governance, and automation projects — from Azure policy reporting to a self-hosted DevSecOps pipeline."
  path="/projects"
>
  <PageHeader
    eyebrow="Selected Work"
    title="Projects"
    subtitle="Case studies in cloud security, DevSecOps automation, and hands-on infrastructure — each one built to solve a real operational problem."
  />
  <div class="container-page pb-24">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</BaseLayout>
