---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex>
  <div class="container-page flex flex-col items-center justify-center py-32 text-center">
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-300">
      <Icon name="shield-alert" class="h-8 w-8" aria-hidden="true" />
    </span>
    <p class="eyebrow mt-6">404</p>
    <h1 class="section-heading mt-2">Page Not Found</h1>
    <p class="body-muted mt-3 max-w-md">
      The page you're looking for has moved, was renamed, or never existed. Let's get you back on
      track.
    </p>
    <a href="/" class="btn-primary mt-8">
      <Icon name="arrow-right" class="h-4 w-4 rotate-180" aria-hidden="true" />
      Back to Home
    </a>
  </div>
</BaseLayout>
