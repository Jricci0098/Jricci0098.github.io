---
import {
  siteConfig,
  NAV_LINKS,
  FOOTER_QUOTE,
  CLOSING_CTA,
  getInitials,
  getVisibleSocialLinks,
} from "@/config/site";
import Icon from "./Icon.astro";
import BrandIcon from "./BrandIcon.astro";

const year = new Date().getFullYear();
const initials = getInitials(siteConfig.name);
const visibleSocialLinks = getVisibleSocialLinks();
---

<footer class="border-t border-slate-200 bg-slate-50 dark:border-navy-800/70 dark:bg-navy-950">
  <div class="container-page py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center dark:border-navy-700/70 dark:bg-gradient-to-br dark:from-navy-900 dark:to-navy-850">
      <h2 class="section-heading">{CLOSING_CTA}</h2>
      <p class="body-muted mx-auto mt-3 max-w-xl">
        Have a project, a role, or a hard problem worth discussing? I'd like to hear about it.
      </p>
      <div class="mt-6">
        <a href="/contact" class="btn-primary">
          Get in Touch
          <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white"
        >
          <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-brand-400/40 bg-brand-500/10 text-sm font-bold text-brand-300">
            {initials}
          </span>
          {siteConfig.name}
        </a>
        <p class="body-muted mt-3 max-w-sm text-sm">{siteConfig.description}</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold tracking-wide text-slate-700 uppercase dark:text-slate-200">
          Navigate
        </h3>
        <ul class="mt-4 space-y-2">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-300"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {visibleSocialLinks.length > 0 && (
        <div>
          <h3 class="text-sm font-semibold tracking-wide text-slate-700 uppercase dark:text-slate-200">
            Connect
          </h3>
          <ul class="mt-4 flex gap-3">
            {visibleSocialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 text-slate-500 transition-colors hover:border-brand-400/60 hover:text-brand-600 dark:border-navy-700/70 dark:text-slate-300 dark:hover:text-brand-300"
                  aria-label={link.label}
                >
                  {link.icon === "github" || link.icon === "linkedin" ? (
                    <BrandIcon name={link.icon} class="h-4 w-4" />
                  ) : (
                    <Icon name={link.icon} class="h-4 w-4" aria-hidden="true" />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-14 flex flex-col items-center gap-3 border-t border-slate-200 pt-8 text-center dark:border-navy-800/70">
      <p class="max-w-2xl text-xs text-slate-500 italic">{FOOTER_QUOTE}</p>
      <p class="text-xs text-slate-500">
        &copy; {year} {siteConfig.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
