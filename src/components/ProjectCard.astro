---
import type { CollectionEntry } from "astro:content";
import ArtPanel from "./ArtPanel.astro";
import Icon from "./Icon.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, status, tags } = project.data;

const statusLabel: Record<typeof status, string> = {
  completed: "Completed",
  "in-progress": "In Progress",
  concept: "Concept",
};
---

<article class="card-surface card-hover group relative flex flex-col overflow-hidden">
  <!-- Decorative — the title link below is the card's single focusable/click target (stretched-link pattern). -->
  <ArtPanel visual={project.data.visual} class="h-40 w-full" />
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex items-center justify-between gap-2">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 dark:border-navy-600 dark:text-slate-300">
        <Icon name="clock" class="h-3 w-3" aria-hidden="true" />
        {statusLabel[status]}
      </span>
    </div>
    <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <p class="body-muted line-clamp-3 text-sm">{description}</p>
    <ul class="mt-auto flex flex-wrap gap-2 pt-2">
      {tags.slice(0, 4).map((tag) => (
        <li class="rounded-full bg-brand-500/10 px-2.5 py-1 text-xs font-medium text-brand-700 dark:text-brand-300">
          {tag}
        </li>
      ))}
    </ul>
  </div>
</article>
