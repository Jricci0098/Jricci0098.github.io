---
/**
 * Abstract cloud/network artwork for the homepage hero. Pure inline SVG + CSS gradients —
 * no external image dependency. Purely decorative, so it's hidden from assistive tech.
 */
const nodes = [
  { x: 60, y: 80 },
  { x: 220, y: 40 },
  { x: 380, y: 110 },
  { x: 120, y: 200 },
  { x: 300, y: 230 },
  { x: 460, y: 180 },
  { x: 200, y: 320 },
  { x: 400, y: 340 },
];

const links: [number, number][] = [
  [0, 1],
  [1, 2],
  [0, 3],
  [1, 4],
  [2, 5],
  [3, 4],
  [4, 5],
  [3, 6],
  [4, 7],
  [5, 7],
  [6, 7],
];
---

<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <div class="absolute -top-24 right-0 h-[22rem] w-[22rem] rounded-full bg-brand-500/15 blur-2xl dark:bg-brand-500/20"></div>
  <div class="absolute top-40 -left-24 h-[18rem] w-[18rem] rounded-full bg-teal-accent/10 blur-2xl dark:bg-teal-accent/10"></div>

  <svg
    viewBox="0 0 520 400"
    class="absolute top-1/2 right-[-4rem] hidden w-[36rem] -translate-y-1/2 opacity-60 sm:block dark:opacity-80"
    fill="none"
  >
    {links.map(([a, b]) => {
      const from = nodes[a];
      const to = nodes[b];
      if (!from || !to) return null;
      return (
        <line
          x1={from.x}
          y1={from.y}
          x2={to.x}
          y2={to.y}
          stroke="url(#hero-line-gradient)"
          stroke-width="1"
        />
      );
    })}
    {nodes.map((node, i) => (
      <circle cx={node.x} cy={node.y} r={i % 3 === 0 ? 5 : 3} class="fill-brand-400" />
    ))}
    <defs>
      <linearGradient id="hero-line-gradient" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#2fc7ff" stop-opacity="0.6"></stop>
        <stop offset="100%" stop-color="#2dd4bf" stop-opacity="0.15"></stop>
      </linearGradient>
    </defs>
  </svg>
</div>
