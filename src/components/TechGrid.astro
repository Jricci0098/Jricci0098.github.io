---
import { technologies, TECH_FILTERS } from "@/data/technologies";
import TechCard from "./TechCard.astro";
---

<div>
  <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter technologies by category">
    {TECH_FILTERS.map((filter, i) => (
      <button
        type="button"
        data-filter={filter}
        aria-pressed={i === 0 ? "true" : "false"}
        class:list={[
          "tech-filter-btn rounded-full border px-4 py-1.5 text-sm font-medium transition-colors duration-200",
          i === 0
            ? "border-brand-400 bg-brand-500/10 text-brand-600 dark:text-brand-300"
            : "border-slate-300 text-slate-600 hover:border-brand-400/60 hover:text-brand-600 dark:border-navy-600 dark:text-slate-300 dark:hover:text-brand-300",
        ]}
      >
        {filter}
      </button>
    ))}
  </div>

  <div id="tech-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {technologies.map((tech) => (
      <TechCard tech={tech} />
    ))}
  </div>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tech-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>("[data-tech-card]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      buttons.forEach((b) => {
        const isActive = b === button;
        b.setAttribute("aria-pressed", String(isActive));
        b.classList.toggle("border-brand-400", isActive);
        b.classList.toggle("bg-brand-500/10", isActive);
        b.classList.toggle("text-brand-600", isActive);
        b.classList.toggle("dark:text-brand-300", isActive);
        b.classList.toggle("border-slate-300", !isActive);
        b.classList.toggle("text-slate-600", !isActive);
        b.classList.toggle("dark:border-navy-600", !isActive);
        b.classList.toggle("dark:text-slate-300", !isActive);
      });

      cards.forEach((card) => {
        const matches = filter === "All" || card.dataset.category === filter;
        card.classList.toggle("hidden", !matches);
      });
    });
  });
</script>
