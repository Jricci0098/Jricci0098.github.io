---
import {
  Activity,
  ArrowRight,
  BadgeCheck,
  BookOpen,
  Boxes,
  Bug,
  CalendarClock,
  ChartLine,
  Check,
  ChevronLeft,
  ChevronRight,
  Clock,
  Cloud,
  CloudCog,
  CloudLightning,
  Code,
  Compass,
  Container,
  Cpu,
  Database,
  DatabaseZap,
  Download,
  Dumbbell,
  ExternalLink,
  FileText,
  FolderGit2,
  FolderOpen,
  GitBranch,
  GitMerge,
  GraduationCap,
  Hammer,
  HandHeart,
  House,
  KeyRound,
  Layers,
  Lightbulb,
  type LucideProps,
  Mail,
  Menu,
  Moon,
  Mountain,
  Music,
  Network,
  Plane,
  CirclePlus,
  Radar,
  Rocket,
  Rss,
  Send,
  Server,
  Shield,
  ShieldAlert,
  ShieldCheck,
  Sparkles,
  Sprout,
  SquareTerminal,
  Sun,
  Tags,
  Target,
  Terminal,
  TriangleAlert,
  Users,
  Workflow,
  Wrench,
  X,
} from "@lucide/astro";

const icons = {
  activity: Activity,
  "arrow-right": ArrowRight,
  "badge-check": BadgeCheck,
  "book-open": BookOpen,
  boxes: Boxes,
  bug: Bug,
  "calendar-clock": CalendarClock,
  "line-chart": ChartLine,
  check: Check,
  "chevron-left": ChevronLeft,
  "chevron-right": ChevronRight,
  clock: Clock,
  cloud: Cloud,
  "cloud-cog": CloudCog,
  "cloud-lightning": CloudLightning,
  code: Code,
  compass: Compass,
  container: Container,
  cpu: Cpu,
  database: Database,
  "database-zap": DatabaseZap,
  download: Download,
  dumbbell: Dumbbell,
  "external-link": ExternalLink,
  "file-text": FileText,
  "folder-git-2": FolderGit2,
  "folder-open": FolderOpen,
  "git-branch": GitBranch,
  "git-merge": GitMerge,
  "graduation-cap": GraduationCap,
  hammer: Hammer,
  "hand-heart": HandHeart,
  home: House,
  "key-round": KeyRound,
  layers: Layers,
  lightbulb: Lightbulb,
  mail: Mail,
  menu: Menu,
  moon: Moon,
  mountain: Mountain,
  music: Music,
  network: Network,
  plane: Plane,
  "plus-circle": CirclePlus,
  radar: Radar,
  rocket: Rocket,
  rss: Rss,
  send: Send,
  server: Server,
  shield: Shield,
  "shield-alert": ShieldAlert,
  "shield-check": ShieldCheck,
  sparkles: Sparkles,
  sprout: Sprout,
  "square-terminal": SquareTerminal,
  sun: Sun,
  tags: Tags,
  target: Target,
  terminal: Terminal,
  "triangle-alert": TriangleAlert,
  users: Users,
  workflow: Workflow,
  wrench: Wrench,
  x: X,
} as const;

export type IconName = keyof typeof icons;

interface Props extends LucideProps {
  name: IconName;
}

const { name, ...rest } = Astro.props;
const IconComponent = icons[name];
---

<IconComponent {...rest} />
