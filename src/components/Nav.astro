---
import { siteConfig, NAV_LINKS, getInitials } from "@/config/site";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const initials = getInitials(siteConfig.name);
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-md dark:border-navy-800/70 dark:bg-navy-950/80">
  <nav class="container-page flex h-16 items-center justify-between" aria-label="Primary">
    <a
      href="/"
      class="flex items-center gap-2 rounded-md text-lg font-bold tracking-tight text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-300 dark:text-white"
    >
      <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-brand-400/40 bg-brand-500/10 text-sm font-bold text-brand-300">
        {initials}
      </span>
      <span class="hidden sm:inline">{siteConfig.name}</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200",
              isActive(link.href)
                ? "text-brand-600 dark:text-brand-300"
                : "text-slate-600 hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-300",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href="/contact" class="btn-primary hidden sm:inline-flex">
        Contact
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-300 text-slate-600 lg:hidden dark:border-navy-700/70 dark:text-slate-300"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" class="h-5 w-5" data-nav-icon-open aria-hidden="true" />
        <Icon name="x" class="hidden h-5 w-5" data-nav-icon-close aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-nav"
    class="hidden border-t border-slate-200 lg:hidden dark:border-navy-800/70"
    data-state="closed"
  >
    <ul class="container-page flex flex-col gap-1 py-4">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "block rounded-md px-3 py-2.5 text-base font-medium transition-colors duration-200",
              isActive(link.href)
                ? "text-brand-600 dark:text-brand-300"
                : "text-slate-600 hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-300",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a href="/contact" class="btn-primary w-full">
          Contact
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const iconOpen = toggle?.querySelector<HTMLElement>("[data-nav-icon-open]");
  const iconClose = toggle?.querySelector<HTMLElement>("[data-nav-icon-close]");

  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    menu.dataset.state = open ? "open" : "closed";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => {
    setOpen(menu?.dataset.state !== "open");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.dataset.state === "open") {
      setOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (menu?.dataset.state !== "open") return;
    const target = event.target as Node;
    if (!menu.contains(target) && !toggle?.contains(target)) {
      setOpen(false);
    }
  });
</script>
