---
import type { TechLevel } from "@/data/technologies";
import { LEVEL_SEGMENTS } from "@/data/technologies";

interface Props {
  level: TechLevel;
  class?: string;
}

const { level, class: className } = Astro.props;
const filled = LEVEL_SEGMENTS[level];
const segments = [1, 2, 3, 4, 5];
---

<div class:list={["flex items-center gap-3", className]}>
  <span class="text-xs font-medium text-slate-400">{level}</span>
  <span class="flex items-center gap-1" role="img" aria-label={`Proficiency: ${level}`}>
    {segments.map((segment) => (
      <span
        class:list={[
          "h-1.5 w-5 rounded-full transition-colors duration-300",
          segment <= filled
            ? "bg-brand-500 group-hover:shadow-[0_0_8px_var(--color-brand-400)] dark:bg-brand-400"
            : "bg-slate-200 dark:bg-navy-700",
        ]}
      />
    ))}
  </span>
</div>
