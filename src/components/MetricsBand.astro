---
import { metrics } from "@/data/metrics";
import Icon, { type IconName } from "./Icon.astro";
---

<section class="border-y border-slate-200 bg-white py-12 dark:border-navy-800/70 dark:bg-navy-900/40">
  <div class="container-page grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
    {metrics.map((metric) => (
      <div class="flex flex-col items-center gap-2 text-center">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-300">
          <Icon name={metric.icon as IconName} class="h-5 w-5" aria-hidden="true" />
        </span>
        <p class="text-sm font-medium text-slate-700 dark:text-slate-300">{metric.label}</p>
      </div>
    ))}
  </div>
</section>
